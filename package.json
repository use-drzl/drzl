{
  "name": "@drzl/root",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "description": "DRZL monorepo",
  "packageManager": "pnpm@11.17.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --sort --workspace-concurrency=1 --filter='{packages/*}' run build",
    "build:publish": "pnpm build:packages && pnpm exec changeset publish",
    "dev": "pnpm --filter @drzl/cli run dev",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier -w .",
    "typecheck": "pnpm -r --filter='{packages/*}' exec tsc -p tsconfig.json --noEmit",
    "verify:packed": "bash scripts/verify-packed.sh",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm -w build && changeset publish",
    "release": "pnpm -w test && pnpm -w build && pnpm -w changeset:version && pnpm -w changeset:publish",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "brand:gen": "node scripts/brand-gen.mjs assets/brand/source.jpeg",
    "brand:gen:lockup": "node scripts/brand-gen.mjs assets/brand/source.jpeg --mode=lockup"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/omar-dulaimi"
  }
}
