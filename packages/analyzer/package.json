{
  "name": "@drzl/analyzer",
  "version": "1.20.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean",
    "lint": "eslint . --ext .ts",
    "test": "vitest run --testTimeout=20000",
    "fuzz": "node test/fuzz/run.mjs",
    "fuzz:gate": "node test/fuzz/run.mjs --gate"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-orm-v1": "npm:drizzle-orm@1.0.0-rc.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-drzl/drzl",
    "directory": "packages/analyzer"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/omar-dulaimi"
  }
}
