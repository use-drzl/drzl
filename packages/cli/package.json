{
  "name": "@drzl/cli",
  "version": "4.24.4",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "drzl": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/config.d.ts",
  "exports": {
    ".": {
      "import": "./dist/cli.js"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/config.ts --format esm,cjs --sourcemap --dts --clean && node scripts/gen-config-schema.mjs",
    "dev": "node --loader ts-node/esm src/cli.ts --help",
    "lint": "eslint . --ext .ts",
    "test": "vitest run --testTimeout=20000"
  },
  "dependencies": {
    "@drzl/analyzer": "workspace:^",
    "@drzl/generator-arktype": "workspace:^",
    "@drzl/generator-effect": "workspace:^",
    "@drzl/generator-express": "workspace:^",
    "@drzl/generator-fastify": "workspace:^",
    "@drzl/generator-graphql": "workspace:^",
    "@drzl/generator-hono": "workspace:^",
    "@drzl/generator-json-schema": "workspace:^",
    "@drzl/generator-nestjs": "workspace:^",
    "@drzl/generator-orpc": "workspace:^",
    "@drzl/generator-service": "workspace:^",
    "@drzl/generator-trpc": "workspace:^",
    "@drzl/generator-typebox": "workspace:^",
    "@drzl/generator-valibot": "workspace:^",
    "@drzl/generator-zod": "workspace:^",
    "@drzl/validation-core": "workspace:^",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@drzl/generator-mcp": "workspace:^"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "drizzle-orm": "^0.45.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-drzl/drzl",
    "directory": "packages/cli"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/omar-dulaimi"
  }
}
