{
  "name": "@drzl/generator-typebox",
  "version": "0.10.5",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean",
    "lint": "eslint . --ext .ts",
    "test": "vitest run --testTimeout=20000"
  },
  "dependencies": {
    "@drzl/analyzer": "workspace:^",
    "@drzl/validation-core": "workspace:^"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-drzl/drzl",
    "directory": "packages/generator-typebox"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/omar-dulaimi"
  },
  "description": "Generate TypeBox schemas from a Drizzle schema",
  "keywords": [
    "typebox",
    "sinclair"
  ],
  "peerDependencies": {
    "@sinclair/typebox": ">=0.32"
  },
  "peerDependenciesMeta": {
    "@sinclair/typebox": {
      "optional": false
    }
  }
}
